#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/_dev_common.sh"

command_name="${1:-}"

case "$command_name" in
  ""|-h|--help|help)
    print_usage
    ;;
  start)
    start_database
    sleep 3
    start_backend
    sleep 2
    start_frontend
    ;;
  start-db)
    start_database
    ;;
  start-be)
    start_backend
    ;;
  start-fe)
    start_frontend
    ;;
  stop)
    stop_all
    ;;
  stop-db)
    stop_database
    ;;
  stop-be)
    stop_backend
    ;;
  stop-fe)
    stop_frontend
    ;;
  restart)
    restart_all
    ;;
  restart-be)
    restart_backend
    ;;
  restart-fe)
    restart_frontend
    ;;
  build)
    build_backend
    build_frontend
    ;;
  build-be)
    build_backend
    ;;
  build-fe)
    build_frontend
    ;;
  test)
    test_backend
    test_frontend
    ;;
  test-be)
    test_backend
    ;;
  test-fe)
    test_frontend
    ;;
  migrate)
    run_migrations
    ;;
  logs)
    show_logs
    ;;
  logs-follow)
    follow_all_logs
    ;;
  logs-be)
    tail -f "$BACKEND_LOG_FILE"
    ;;
  logs-fe)
    tail -f "$FRONTEND_LOG_FILE"
    ;;
  logs-db)
    docker logs streamline-db -f
    ;;
  *)
    echo "Unknown command: $command_name" >&2
    echo "" >&2
    print_usage >&2
    exit 1
    ;;
esac